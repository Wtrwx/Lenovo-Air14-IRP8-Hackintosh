 static void appleHDALoaded(void *, KernelPatcher &patcher, size_t id, mach_vm_address_t address, size_t size) {
+    // Lilu broadcasts every monitored kext to all registered callbacks.
+    if (appleHDAInfo.loadIndex == KernelPatcher::KextInfo::Unloaded || id != appleHDAInfo.loadIndex) {
+        HookManager::status().unrelatedCallbacks++;
+        return;
+    }
     HookManager::status().kextCb++;
     HookManager::install(patcher, id, address, size);
+    if (auto service = IntelSSTDMIC::instance()) service->stateChanged();
 }
 
